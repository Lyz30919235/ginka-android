+// Locates bounded salt candidates immediately before V2Link markers.
+fn v2link_salt_offsets(data: &[u8]) -> Vec<usize> {
+    data.windows(8)
+        .enumerate()
+        .filter_map(|(offset, bytes)| {
+            (bytes == b"V2Link\0\0")
+                .then(|| offset.checked_sub(EXE_RESOURCE_SALT_SIZE))
+                .flatten()
+        })
+        .collect()
+}
