+#[cfg(test)]
+mod tests {
+    use super::{EXE_RESOURCE_SALT_SIZE, v2link_salt_offsets};
+
+    // Rejects marker offsets that cannot contain a complete preceding salt.
+    #[test]
+    fn v2link_candidates_require_full_salt() {
+        assert!(v2link_salt_offsets(b"V2Link\0\0").is_empty());
+        let mut bytes = vec![0x5a; EXE_RESOURCE_SALT_SIZE + 7];
+        bytes.extend_from_slice(b"V2Link\0\0");
+        assert_eq!(v2link_salt_offsets(&bytes), vec![7]);
+        assert!(v2link_salt_offsets(&bytes[..bytes.len() - 1]).is_empty());
+    }
+}
